# Copy to .env (never committed) or set these in your shell. Values are secrets: do not
# paste them into configs, code, issues or chat.

# Cloudflare R2 -- large files: datasets, token shards, tokenizer artifacts, best.pt
ORED_R2_ACCOUNT_ID=
ORED_R2_ACCESS_KEY_ID=
ORED_R2_SECRET_ACCESS_KEY=
ORED_R2_BUCKET=
# Optional: a custom endpoint instead of https://<account>.r2.cloudflarestorage.com
ORED_R2_ENDPOINT=
# Optional: the object prefix (default ored-ai)
ORED_R2_PREFIX=

# Supabase -- metadata only (ored_datasets registry). Server side only; the service-role
# key must never reach a browser or client.
ORED_SB_URL=
ORED_SB_SERVICE_KEY=
